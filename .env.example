# Copia este archivo como .env y rellena los valores (en tu PC y en el servidor; cada uno el suyo).
# Esta plantilla NO debe llevar claves reales: nunca subas .env a git (ya está en .gitignore).
ENV=development

DATABASE_URL=postgresql://nexus:CAMBIAR@127.0.0.1:5432/nexus
REDIS_URL=redis://127.0.0.1:6379/0

# Discord Developer Portal -> tu aplicación
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
# ID (o enlace) de tu servidor de pruebas: los comandos slash se registran ahí al instante. Vacío en producción.
DEV_GUILD_ID=

DASHBOARD_URL=http://localhost:3000
# Genera una con: py -3.12 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Producción (Docker + Cloudflare Tunnel; ver docs/DEPLOY.md) ---
# En el servidor: ENV=production, DEV_GUILD_ID vacío y DASHBOARD_URL / DISCORD_REDIRECT_URI con tu dominio https.
# DATABASE_URL y REDIS_URL los pone docker-compose.yml (apuntan a los contenedores nexus-db y nexus-redis).
# Base de datos del contenedor nexus-db. Contraseña: openssl rand -hex 24
DB_USER=nexus
DB_PASSWORD=
DB_NAME=nexus
# Puerto del servidor donde se publica el panel (el túnel usa nexus-dashboard:3000 por la red cloudflare_red)
NEXUS_PORT=5010
# true detrás de Cloudflare: usa CF-Connecting-IP como IP real (docker-compose ya lo pone)
TRUST_CLOUDFLARE=false

# --- Opcional (fase 7) ---
# Avisos de Twitch: crea una aplicación en https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# IA de moderación: clave de https://console.anthropic.com (los mensajes analizados se envían a Anthropic)
ANTHROPIC_API_KEY=
# Modelo para la IA de moderación (por defecto claude-opus-5-5; claude-haiku-5-5 es mucho más barato)
NEXUS_AI_MODEL=claude-opus-5-5
